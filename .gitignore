# Dependencies
node_modules/
# ...and the bare symlink form. Worktrees don't get their own install, so
# node_modules here is a symlink to the main checkout's — which the trailing
# slash above does not match, and it would otherwise get committed.
node_modules
/.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Lock files (keep one)
# bun.lockb     # uncomment if not using bun
# package-lock.json   # uncomment if using bun/yarn
yarn.lock
pnpm-lock.yaml

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Vite
.vite/
.vercel
.claude/
